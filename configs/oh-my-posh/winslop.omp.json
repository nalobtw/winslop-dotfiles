{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "session",
          "style": "plain",
          "foreground": "#C5BEB1",
          "template": "{{ .UserName }}@{{ .HostName }} "
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "#9FC3CD",
          "template": "{{ .Path }} "
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#B9A2D0",
          "template": "❯"
        }
      ]
    }
  ]
}
