<!--
    Name: Winslop Midnight Alley
    IsDark: True
    HasBlur: False
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <system:Boolean x:Key="ThemeBlurEnabled">False</system:Boolean>
    <system:String x:Key="SystemBG">Dark</system:String>
    <Color x:Key="LightBG">#FF201D2C</Color>
    <Color x:Key="DarkBG">#FF201D2C</Color>
    <Style x:Key="WindowBorderStyle" BasedOn="{StaticResource BaseWindowBorderStyle}" TargetType="{x:Type Border}">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#777C90" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="#FF201D2C" />
    </Style>
    <Style x:Key="QueryBoxStyle" BasedOn="{StaticResource BaseQueryBoxStyle}" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="#FF201D2C" />
        <Setter Property="Foreground" Value="#FFC5BEB1" />
        <Setter Property="CaretBrush" Value="#FFB9A2D0" />
        <Setter Property="FontFamily" Value="JetBrainsMono Nerd Font" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Height" Value="42" />
    </Style>
    <Style x:Key="QuerySuggestionBoxStyle" BasedOn="{StaticResource BaseQuerySuggestionBoxStyle}" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="#FF2B2839" />
        <Setter Property="Foreground" Value="#FFA49AAE" />
        <Setter Property="FontFamily" Value="JetBrainsMono Nerd Font" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Height" Value="42" />
    </Style>
    <Style x:Key="ItemTitleStyle" BasedOn="{StaticResource BaseItemTitleStyle}" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#FFC5BEB1" />
        <Setter Property="FontFamily" Value="JetBrainsMono Nerd Font" />
    </Style>
    <Style x:Key="ItemTitleSelectedStyle" BasedOn="{StaticResource BaseItemTitleSelectedStyle}" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#FF9FC3CD" />
        <Setter Property="FontFamily" Value="JetBrainsMono Nerd Font" />
    </Style>
    <Style x:Key="ItemHotkeyStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#FFB9A2D0" />
        <Setter Property="FontFamily" Value="JetBrainsMono Nerd Font" />
    </Style>
    <SolidColorBrush x:Key="ItemSelectedBackgroundColor">#FF3E3A4C</SolidColorBrush>
</ResourceDictionary>
